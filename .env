# Setup logging with very specific crate targets
RUST_LOG=info,e-lupane::crates::installer=debug

# Application Config
APP_NAME=E-Lupane
ENVIRONMENT=development

# Plugin module
PUGIN_DIR=plugins

# Database — PostgreSQL runs inside WSL (provision with:
#   cargo run -p installer -- --setup
# ). Role/database `elupane` created with password `elupane`.
DATABASE_URL=postgres://elupane:elupane@localhost:5432/elupane

# Redis — the inter-plugin messaging backbone.
REDIS_URL=redis://127.0.0.1:6379

