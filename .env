# Setup logging with very specific crate targets
RUST_LOG=info,e-lupane::crates::installer=debug

# Application Config
APP_NAME=E-Lupane
ENVIRONMENT=development

# Plugin module
PUGIN_DIR=plugins

# Database — PostgreSQL runs inside WSL (provision with:
#   cargo run -p installer -- --setup
# ). Role/database `elupane` created with password `elupane`.
DATABASE_URL=postgres://elupane:elupane@localhost:5432/elupane

# Redis — the inter-plugin messaging backbone.
REDIS_URL=redis://127.0.0.1:6379

# Google Auth
GOOGLE_OAUTH_CLIENT_ID=338417188562-1oh744jl7mn4aim1h6ctbci1a26884sq.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=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
GOOGLE_OAUTH_REDIRECT_URI=http://127.0.0.1:8090/auth/google/callback
# Comma-separated Google account emails allowed to create courses (everyone else is a student).
GOOGLE_CLASSROOM_SUPER_ADMINS=pterror11@gmail.com
GOOGLE_CLASSROOM_ADMINS=pterror11@gmail.com
GOOGLE_CLASSROOM_DEANS=pterror11@gmail.com
GOOGLE_CLASSROOM_DEVELOPERS=pterror11@gmail.com
GOOGLE_CLASSROOM_HODS=pterror11@gmail.com
GOOGLE_CLASSROOM_LECTURERS=pterror11@gmail.com
# Set to 1 to enable GET /api/auth/google/dev_login?email=... (dev smoke tests only).
GOOGLE_DEV_LOGIN=0