# Port / IP for the Dioxus server. `dx serve --port 8090` sets these
# automatically; these are sensible defaults if you run the server directly
# (e.g. `cargo run --features server` with PORT=8090).
PORT=8090
IP=0.0.0.0

# SQLx / PostgreSQL connection, used by the server build.
# Role/database `elupane` created with password `elupane`
# (provision with: cargo run -p installer -- --setup).
DATABASE_URL=postgres://elupane:elupane@localhost:5432/elupane?sslmode=disable

# Redis — the inter-plugin messaging backbone. The frontend server talks to the
# auth plugin over it (login / verify RPC).
REDIS_URL=redis://127.0.0.1:6379

# Google OAuth ("Sign in with Google"). Also set in the root .env.
GOOGLE_OAUTH_CLIENT_ID=338417188562-1oh744jl7mn4aim1h6ctbci1a26884sq.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=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
GOOGLE_OAUTH_REDIRECT_URI=http://127.0.0.1:8090/auth/google/callback
# Comma-separated allow-lists (first match wins; everyone else is a student).
GOOGLE_CLASSROOM_SUPER_ADMINS=pterror11@gmail.com
GOOGLE_CLASSROOM_ADMINS=pterror11@gmail.com
GOOGLE_CLASSROOM_DEANS=pterror11@gmail.com
GOOGLE_CLASSROOM_DEVELOPERS=pterror11@gmail.com
GOOGLE_CLASSROOM_HODS=pterror11@gmail.com
GOOGLE_CLASSROOM_LECTURERS=pterror11@gmail.com
# Set to 1 to enable GET /api/auth/google/dev_login?email=... (dev only).
GOOGLE_DEV_LOGIN=0
